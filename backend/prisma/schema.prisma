// Este archivo es la fuente de verdad del esquema de base de datos.
// Siempre usar Prisma para acceder a la BD — nunca SQL raw.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AdminRole {
  ADMIN
  CONTABILIDAD
  IT
  RECEPCION
  DISENO
  PRODUCCION
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  showInWizard Boolean  @default(false)
  isCustomizable Boolean @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  products    Product[]
}

enum ProductShape {
  RECTANGULAR
  CIRCULAR
  OVAL
  SQUARE
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  CONFIRMED
  IN_PRODUCTION
  FINISHED
  SHIPPED
  CANCELLED
}

enum PaymentMethod {
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum EmailStage {
  PAYMENT_RECEIVED
  ORDER_CONFIRMED
  ORDER_FINISHED
}

// ============================================================
// MODELOS
// ============================================================

model User {
  id              String   @id @default(uuid())
  googleId        String   @unique
  email           String   @unique
  name            String?
  picture         String?
  phone           String?
  billingAddress  Json?    // { address, municipality, department, nitOrCui, invoiceName }
  deliveryAddress Json?    // { address, municipality, department }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(PRODUCCION)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  approvedOrders Order[] @relation("AdminApprovedBy")
}

model Product {
  id          String        @id @default(uuid())
  sku         String        @unique
  name        String
  description String?
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  shape       ProductShape?
  widthMm     Float?
  heightMm    Float?
  widthPx     Int?
  heightPx    Int?
  imageUrl       String?
  imageUrlHover  String?
  basePrice      Float
  isActive    Boolean       @default(true)
  stock       Int           @default(0)
  salesCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems     OrderItem[]
  inventoryLogs  InventoryLog[]
  waitlist       WaitlistEntry[]
  discounts      Discount[]
}

model Ink {
  id        String  @id @default(uuid())
  code      String  @unique
  color     String
  hexCode   String
  price     Float
  stock     Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

model Font {
  id            String   @id @default(uuid())
  name          String
  fileName      String
  originalName  String?
  fileData      String?  @db.Text // Contenido base64 del TTF/OTF para renderizado sin dependencia del filesystem
  strokeRatio   Float?   // Grosor de trazo real medido con opentype.js (ej. 0.08 = fino, 0.15 = grueso)
  minFontSizePt Float?   @default(10) // Tamano minimo fabricable para esta fuente (configurable por admin)
  isDefault     Boolean  @default(false) // Fuente predeterminada en el disenador
  uploadedAt    DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique
  userId               String
  status               OrderStatus   @default(DRAFT)
  paymentMethod        PaymentMethod?
  totalAmount          Float         @default(0)
  shippingAddress      Json?
  nitOrCui             String?
  invoiceName          String?
  pagaloTransactionId  String?
  tekraInvoiceUuid     String?
  courierTracking      String?
  isGovernment         Boolean       @default(false)
  isLawyerReplica      Boolean       @default(false)
  requiresAdminApproval Boolean      @default(false)
  adminApprovedAt      DateTime?
  adminApprovedBy      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  approvedBy    AdminUser?  @relation("AdminApprovedBy", fields: [adminApprovedBy], references: [id])
  items         OrderItem[]
  payments      Payment[]
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String
  productId         String
  inkId             String?
  quantity          Int     @default(1)
  unitPrice         Float
  designJson        Json?
  previewPngUrl     String?
  productionSvgUrl  String?
  notes             String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  ink     Ink?    @relation(fields: [inkId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  method        PaymentMethod
  amount        Float
  status        PaymentStatus @default(PENDING)
  referenceCode String?
  receiptUrl    String?
  confirmedAt   DateTime?
  confirmedBy   String?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id        String   @id @default(uuid())
  productId String
  delta     Int
  reason    String
  createdBy String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Discount {
  id          String       @id @default(uuid())
  name        String
  type        DiscountType
  value       Float
  minQuantity Int          @default(1)
  productId   String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  product Product? @relation(fields: [productId], references: [id])
}

model WaitlistEntry {
  id        String   @id @default(uuid())
  productId String
  email     String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, email])
}

model EmailTemplate {
  id        String     @id @default(uuid())
  stage     EmailStage @unique
  subject   String
  htmlBody  String
  updatedAt DateTime   @updatedAt
}

model SiteSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model RoleConfig {
  id          String    @id @default(uuid())
  role        AdminRole @unique
  permissions Json      // { orders: true, inventory: true, payments: true, design: true, notifications: true, admin: true, discounts: true, fonts: true }
  updatedAt   DateTime  @updatedAt
}

enum SliderButtonType {
  URL
  CATEGORY
  PRODUCT
}

model SliderImage {
  id             String           @id @default(uuid())
  title          String
  subtitle       String?
  imageUrl       String
  gradient       String?          // CSS gradient classes, ej: "from-[#1B2A6B] to-[#0f1a4a]"
  useGradient    Boolean          @default(true)      // activar/desactivar capa de gradiente sobre imagen
  gradientOpacity Float           @default(0.85)      // opacidad del overlay (0-1)
  animation      String           @default("fade-up") // fade-up, fade-left, fade-right, zoom-in, slide-up
  buttonText     String           @default("Crear mi sello")
  buttonType     SliderButtonType @default(URL)
  buttonUrl      String?          // URL libre cuando buttonType = URL
  buttonCategorySlug String?      // Slug de categoría cuando buttonType = CATEGORY
  buttonProductId    String?      // ID de producto cuando buttonType = PRODUCT
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}
