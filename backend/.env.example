# ============================================================
# misello.gt — Variables de Entorno (ejemplo)
# NUNCA subir el archivo .env real a GitHub.
# Copiar este archivo a .env y completar los valores reales.
# ============================================================

# --------------------------------------------------
# Base de Datos (PostgreSQL)
# --------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/misello_db

# --------------------------------------------------
# Google OAuth (autenticación de clientes públicos)
# --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# --------------------------------------------------
# JWT (panel de administración interno)
# --------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=7d

# --------------------------------------------------
# Claude API (asistente de diseño)
# --------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --------------------------------------------------
# Pagalo.gt (pasarela de pagos con tarjeta)
# --------------------------------------------------
PAGALO_API_URL=https://apitest.pagalo.co/v1
PAGALO_API_KEY=
PAGALO_BUSINESS_UUID=

# --------------------------------------------------
# Tekra S.A. (facturación electrónica FEL)
# --------------------------------------------------
TEKRA_API_URL=https://apicertificacion.desa.tekra.com.gt
TEKRA_USUARIO=
TEKRA_CLAVE=
TEKRA_CLIENTE=
TEKRA_CONTRATO=

# --------------------------------------------------
# Tekra NIT/CUI validación
# --------------------------------------------------
TEKRA_SEGUIMIENTO_URL=https://apiseguimiento.tekra.com.gt

# --------------------------------------------------
# ReCaptcha v3 (requisito de Pagalo.gt)
# --------------------------------------------------
RECAPTCHA_SECRET_KEY=

# --------------------------------------------------
# Correo electrónico (notificaciones transaccionales)
# --------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@misello.gt

# --------------------------------------------------
# Entorno y Puerto
# --------------------------------------------------
NODE_ENV=development
PORT=3000

# --------------------------------------------------
# Frontend (para CORS)
# --------------------------------------------------
FRONTEND_URL=http://localhost:3001
